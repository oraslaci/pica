#-THROTTLE GROUP -----------------------#

throttle/pageup: throttle/tilebg
m_offsetLT
YConstraint 1, 0.5, 0
m_autorepeat
Property normalcursor 1

throttle/pagedown: throttle/tilebg
m_offsetLB
YConstraint 0, 0.5, 0
m_autorepeat
Property normalcursor 1

#throttle/throttlehome: throttle/tilebg
#m_offsetR
#YConstraint 0.5, 0.5, 0

#includesystem throttlethumb

throttle/tilebg: thumbui/throttlegroup
m_offsetRTB

throttle/albumscrolltop: thumbui/throttlegroup
m_offsetRT
m_autorepeat

throttle/prevalbum: thumbui/throttlegroup
m_offsetRT
m_autorepeat

throttle/albumscrollbottom: thumbui/throttlegroup
m_offsetRB
m_autorepeat

throttle/nextalbum: thumbui/throttlegroup
m_offsetRB
m_autorepeat
