XConstraint .5, .5, -1
YConstraint .5, .5, -1
acquirepanel/startoggle: acquirepanel/togglegroup
m_offsetB
Property showtarget acquirepanel/startoggle_icon1
Property hidetarget acquirepanel/startoggle_icon0
XConstraint 0, 0, 6

acquirepanel/exclude_icon: acquirepanel/excludetoggle
m_centerXY
