acquirepanel/togglegroup: acquirepanel/contbuttonscontainer
m_offsetB
XConstraint 0, 0, 0

acquirepanel/fileinfo: acquirepanel/fileinfocontainer
m_centerXY
m_displayfont12

acquirepanel/fileinfocontainer: acquirepanel/controlcontainer
m_offsetT
m_centerX

