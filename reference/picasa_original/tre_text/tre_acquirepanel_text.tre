#-----------------------------------------------------------
# SELECTION AREA
#-----------------------------------------------------------
acquirepanel/softbevelRT: acquirepanel/controlcontainer
m_scaleXY

acquirepanel/nothing: acquirepanel/selcontainer
m_displayfont18
Property textalign center
m_centerXY

acquirepanel/selcontainer: acquirepanel/softbevelLT
m_offsetLTRB

acquirepanel/deletedadorner: acquirepanel/center_base
m_hidden

#-----------------------------------------------------------
# PREVIEW AREA
#-----------------------------------------------------------
acquirepanel/thumbpreview: acquirepanel/thumbpreviewbk
m_centerX
m_centerY
Property scaleclamp 1
m_shadow

acquirepanel/thumbpreviewbk: acquirepanel/controlcontainer
m_offsetLTRB

