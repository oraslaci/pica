#-----------------------------------------------------------
# INCLUDES 
#-----------------------------------------------------------

#includeonce macros.tre
#include geopaneltext.tre

geopanel/map_menu: geopanel/base
m_offsetRT
Property itempadding 2 1 23 2

geopanel/mapnode: geopanel/base
XConstraint 0, 0, 2
XConstraint 1, 1, -3
m_offsetT
#YConstraint 1, 1, 0
m_offsetB
m_hidden

geopanel/places_icon: geopanel/base
m_offsetLT

##
## LOADING
##
geopanel/loading_title: geopanel/loading_base
m_centerX
YConstraint 0.5, 0.5, -20
m_displayfont16
Property textalign center

geopanel/loading_icon: geopanel/loading_base
m_centerX
YConstraint 0.5, 0.5, 20

geopanel/loading_base: geopanel/base
XConstraint 0, 0, 2
XConstraint 1, 1, -3
m_offsetT
m_offsetB

geopanel/geo_info: geopanel/base
m_displayfont12
m_offsetLT

##
## SEARCH
##
geopanel/searchinput: geopanel/searchinput_base
m_offsetLT

geopanel/searchinput_base: geopanel/search_group
m_offsetLT

geopanel/search_icon: geopanel/search
m_offsetLT

geopanel/search: geopanel/search_group
m_offsetLT

geopanel/search_label: geopanel/base
m_displayfont12
m_offsetLB

geopanel/search_group: geopanel/base
m_offsetB
m_centerX

geopanel/base: root
m_scaleXY

