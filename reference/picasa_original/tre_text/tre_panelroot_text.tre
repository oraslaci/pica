#include thumbui.tre
#include editoneup.tre
#include editoneuptext.tre
#include panelroot_text.tre

panelroot/mainuipanel: root
m_scaleX
YConstraint 0, 0, tabdiv=0
YConstraint 1, 1, 0

#panelroot/featurepanel: root
#m_scaleX
#YConstraint 0, 0, tabdiv=0
#YConstraint 1, 1, 0
#m_hidden

#panelroot/syncpanel: root
#m_scaleX
#YConstraint 0, 0, tabdiv
#YConstraint 1, 1, 0
#Property addtofocus syncpanel/synclist
#m_hidden

panelroot/makemoviepanel: root
m_scaleX
YConstraint 0, 0, tabdiv
YConstraint 1, 1, 0
m_hidden
Property addtofocus makemoviepanel/filmoverlaycontainer
Property addtofocus makemoviepanel/filmstrip
Property addtofocus makemoviepanel/previewimage
Property addtofocus makemoviepanel/movieparent
Property addtofocus makemoviepanel/cancel

panelroot/collagepanel: root
m_scaleX
YConstraint 0, 0, tabdiv
YConstraint 1, 1, 0
m_hidden
Property addtofocus collagepanel/sharebutton
Property addtofocus collagepanel/cancelbutton
Property addtofocus collagepanel/previewroot

panelroot/acquirepanel: root
m_scaleX
YConstraint 0, 0, tabdiv
YConstraint 1, 1, 0
m_hidden
Property addtofocus acquirepanel/subfolder
Property addtofocus acquirepanel/anowbutton
Property addtofocus acquirepanel/acancelbutton
Property addtofocus acquirepanel/selcontainer
Property addtofocus acquirepanel/nextbutton
Property addtofocus acquirepanel/previousbutton

panelroot/swap: root
XConstraint 1, 1, 0
YConstraint 0, 0, 0
Handler varbutton tabdiv 29 0
m_fakehidden

panelroot/picasatab: panelroot/globaltabs
Property showtarget panelroot/mainuipanel
Property setpressed 1
Handler panelgateway

#panelroot/synctab: panelroot/globaltabs
#Property showtarget panelroot/syncpanel
#m_hidden

#panelroot/featuretab: panelroot/globaltabs
#Property showtarget panelroot/featurepanel
#m_hidden

panelroot/makemovietab: panelroot/globaltabs
Property showtarget panelroot/makemoviepanel
m_hidden

panelroot/youtab: panelroot/globaltabs
Property showtarget panelroot/mainuipanel
m_hidden

panelroot/collagetab: panelroot/globaltabs
Property showtarget panelroot/collagepanel
m_hidden

panelroot/acquiretab: panelroot/globaltabs
Property showtarget panelroot/acquirepanel
m_hidden

panelroot/capturemovietab: panelroot/globaltabs
Property showtarget panelroot/capturemoviepanel
m_hidden

panelroot/globaltabs: panelroot/tabback
m_scaleXY

panelroot/transitionroot: root
m_scaleX
YConstraint 0, 0, tabdiv
YConstraint 1, 1, 0

panelroot/tabback: root
m_scaleX
Property sethiquality 0
YConstraint 1, 0, tabdiv

