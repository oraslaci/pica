#includeonce macros.tre
#include uploadallinstructionpanel_text.tre

uploadallinstructionpanel/title: uploadallinstructionpanel/base
XConstraint 0, 0, 40
XConstraint 1, 1, -40
YConstraint 0, 0, 16
m_displayfont16
Property textalign center

uploadallinstructionpanel/body: uploadallinstructionpanel/base
XConstraint 0, 0, 16
XConstraint 1, 1, -16
YConstraint 0, 0, 45
m_displayfont14

uploadallinstructionpanel/close-label: uploadallinstructionpanel/close
m_buttonfontC
uploadallinstructionpanel/close: uploadallinstructionpanel/base
m_buttontypecolor3
m_offsetRB

uploadallinstructionpanel/base: root
