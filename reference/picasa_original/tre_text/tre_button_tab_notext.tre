#includeonce macros.tre
# properties for a tab
Property button_state_n tab/n
Property button_state_p tab/p
Property button_state_h tab/h
Property button_buttcon 1
Property normalcursor 1
m_buttontypecolor
cd -label
YConstraint .5, .5, 0
m_displayfont14
Property fontleading 10
#Property textalign center
Property textwrap 1
XConstraint 0, 0, 28
XConstraint 1, 1, -18
cd ..
cd -icon
XConstraint 0, 0, 5
YConstraint 0.5, 0.5, 0
