#---Save Edits ----------------------
#headerpanel/edit_count: headerpanel/headerbase
#m_offsetLT
#Property textalign right

headerpanel/save_edits_icon: headerpanel/save_edits
m_centerXY
headerpanel/save_edits: headerpanel/headerbase
m_offsetLT
m_buttontypecolor
SharedHandler headerpanel/tip hottip headerpanel/create_label

#---Web Links ----------------------

headerpanel/view_online-label: headerpanel/view_online
m_displayfont12
#XConstraint 1, 1, 0
XConstraint 0, 0, 0
YConstraint .5, .5, 0
headerpanel/view_online: headerpanel/headerbase
m_offsetLT
m_buttonfont
Property forceuidirection 1

headerpanel/sync_options_icon: headerpanel/sync_options
YConstraint 0.5, 0.5, 0
AbsXConstraint 0.5, 0.5, -1

headerpanel/sync_options: headerpanel/headerbase
m_offsetLT
Property mousedown 1
Property normalcursor 1
SharedHandler headerpanel/tip hottip headerpanel/create_label

headerpanel/share: headerpanel/headerbase
m_offsetLT
m_buttontypecolor
#Property normalcursor 1
SharedHandler headerpanel/tip hottip headerpanel/create_label

headerpanel/shadow: headerpanel/headerbase
m_scaleX
m_offsetT

#---Base ----------------------

headerpanel/headerbase0: root
m_scaleX
m_offsetT

headerpanel/headerbase1: root
m_scaleX
m_offsetT
m_hidden

headerpanel/headerbase: root
m_scaleX
m_offsetT

#includeredirect headerpaneltext.tre headerpanel
