#includeonce macros.tre

#---Album Info--------------------
headerpanel/album_description: headerpanel/headerbase
m_offsetLT
Property fontname Georgia
Property fontsize 14

headerpanel/album_title: headerpanel/album_title_clip
m_offsetLT
Property fontname Georgia
Property fontsize 20

headerpanel/title_fade0: headerpanel/album_title_clip
m_offsetT
XConstraint 1, 1, 0

headerpanel/title_fade1: headerpanel/album_title_clip
m_offsetT
XConstraint 1, 1, 0
m_hidden

headerpanel/album_title_clip: headerpanel/headerbase
m_offsetT
XConstraint 0, 0, 50
#XConstraint 1, 1, -162
XConstraint 1, 1, -20

#--- Play Slideshow
headerpanel/play_icon: headerpanel/play
m_centerXY
headerpanel/play: headerpanel/headerbase
m_offsetLT
Property mousedown 1
SharedHandler headerpanel/tip hottip headerpanel/create_label

headerpanel/dividers: headerpanel/headerbase
m_offsetLT

#---Create Cluster----------------------
headerpanel/create_label: headerpanel/headerbase
m_offsetLT
#Property textalign right
#XConstraint 1, 0, 158
#m_buttonfont

headerpanel/sync_label: headerpanel/headerbase
m_offsetRT
m_displayfont12
Property textalign right

headerpanel/websync0: headerpanel/headerbase
m_offsetRT
Property normalcursor 1
Property showtarget headerpanel/websync1
Property hidetarget headerpanel/websync0
SharedHandler headerpanel/tip hottip headerpanel/create_label

headerpanel/websync1: headerpanel/headerbase
m_offsetRT
Property normalcursor 1
Property hidetarget headerpanel/websync1
Property showtarget headerpanel/websync0
SharedHandler headerpanel/tip hottip headerpanel/create_label
m_hidden

#headerpanel/cd_icon: headerpanel/create_cd
#m_offsetLT
#headerpanel/create_cd: headerpanel/headerbase
#m_offsetLT
#Property normalcursor 1
#Property mousedown 1
#SharedHandler headerpanel/tip hottip headerpanel/create_label

headerpanel/movie_icon: headerpanel/create_movie
YConstraint 0.5, 0.5, -1
AbsXConstraint 0.5, 0.5, -2

headerpanel/create_movie: headerpanel/headerbase
m_offsetLT
Property normalcursor 1
Property mousedown 1
SharedHandler headerpanel/tip hottip headerpanel/create_label

headerpanel/collage_icon: headerpanel/create_collage
YConstraint 0.5, 0.5, -1
AbsXConstraint 0.5, 0.5, -1

headerpanel/create_collage: headerpanel/headerbase
m_offsetLT
Property normalcursor 1
Property mousedown 1
SharedHandler headerpanel/tip hottip headerpanel/create_label

#---Select ----------------------
headerpanel/selecthelp: headerpanel/headerbase
m_offsetLT

#headerpanel/select_label: headerpanel/headerbase
#m_offsetLT
#Property textalign right
##XConstraint 1, 0, 338

headerpanel/star_icon: headerpanel/select_star
YConstraint 0.5, 0.5, -1
XConstraint 0.5, 0.5, 0
headerpanel/select_star: headerpanel/headerbase
Property normalcursor 1
Property mousedown 1
m_offsetLT
SharedHandler headerpanel/tip hottip headerpanel/create_label

#headerpanel/select_faces_icon: headerpanel/select_faces
#m_offsetLT
#headerpanel/select_faces: headerpanel/headerbase
#Property normalcursor 1
#Property mousedown 1
#m_offsetLT
