#includeonce macros.tre

#---Album Info--------------------

unknownfaceheaderpanel/album_title: unknownfaceheaderpanel/album_title_clip
m_offsetLT
Property fontname Georgia
Property fontsize 24

unknownfaceheaderpanel/album_title_clip: unknownfaceheaderpanel/headerbase
m_offsetLT
#XConstraint 0, 0, 16
XConstraint 1, 1, -90

unknownfaceheaderpanel/faceicon: unknownfaceheaderpanel/headerbase
m_offsetLT

unknownfaceheaderpanel/info_text: unknownfaceheaderpanel/headerbase
m_offsetLT


#---Buttons ----------------------

unknownfaceheaderpanel/cluster: unknownfaceheaderpanel/clustering_container
m_offsetLT
Property hidetarget unknownfaceheaderpanel/cluster
Property showtarget unknownfaceheaderpanel/showall
m_hidden

unknownfaceheaderpanel/showall: unknownfaceheaderpanel/clustering_container
m_offsetLT
Property hidetarget unknownfaceheaderpanel/showall
Property showtarget unknownfaceheaderpanel/cluster

unknownfaceheaderpanel/clustering_container: unknownfaceheaderpanel/headerbase
m_offsetRT

unknownfaceheaderpanel/showignored: unknownfaceheaderpanel/viewtype_container
m_offsetLT
Property hidetarget unknownfaceheaderpanel/showignored
Property showtarget unknownfaceheaderpanel/showunknown

unknownfaceheaderpanel/showunknown: unknownfaceheaderpanel/viewtype_container
m_offsetLT
Property hidetarget unknownfaceheaderpanel/showunknown
Property showtarget unknownfaceheaderpanel/showignored
m_hidden

unknownfaceheaderpanel/viewtype_container: unknownfaceheaderpanel/headerbase
m_offsetRT


unknownfaceheaderpanel/ignore: unknownfaceheaderpanel/headerbase
m_hidden
m_offsetRT
SharedHandler unknownfaceheaderpanel/hottip hottip unknownfaceheaderpanel/hottip_label

unknownfaceheaderpanel/addname_instructions: unknownfaceheaderpanel/headerbase
m_offsetLT
m_displayfont12
m_hidden
XConstraint 1, 1, -16
Property textwrap 0

unknownfaceheaderpanel/hottip_label: unknownfaceheaderpanel/headerbase
m_offsetRT
m_displayfont12
Property textalign right

unknownfaceheaderpanel/addname: unknownfaceheaderpanel/headerbase
m_hidden
m_offsetRT
m_buttontypecolor
SharedHandler unknownfaceheaderpanel/hottip hottip unknownfaceheaderpanel/hottip_label


#---Base ----------------------

unknownfaceheaderpanel/shadow: unknownfaceheaderpanel/headerbase
m_scaleX
m_offsetT

unknownfaceheaderpanel/headerbase0: root
m_scaleX
m_offsetT

unknownfaceheaderpanel/headerbase1: root
m_scaleX
m_offsetT
m_hidden

unknownfaceheaderpanel/headerbase: root
m_scaleX
m_offsetT


#includeredirect unknownfaceheaderpaneltext.tre unknownfaceheaderpanel






