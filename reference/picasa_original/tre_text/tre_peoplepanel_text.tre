#-----------------------------------------------------------
# INCLUDES 
#-----------------------------------------------------------

#includeonce macros.tre
#include peoplepanel_text.tre

peoplepanel/status_label: peoplepanel/base
m_displayfont14
m_offsetLT

peoplepanel/instructions: peoplepanel/peoplelist
XConstraint 0, 0, 16
XConstraint 1, 1, -16
YConstraint 0, 0, 0
YConstraint 1, 1, -16
m_displayfont14

peoplepanel/peoplelist: peoplepanel/base
m_offsetT
m_scaleX
YConstraint 1, 1, PEOPLELISTBOTTOM=0

peoplepanel/manual_add: peoplepanel/base
m_centerX
YConstraint 1, 1, -4
m_hidden
Property showtarget peoplepanel/manual_frame
Property hidetarget peoplepanel/status_label
Property hidetarget peoplepanel/peoplelist
Property hidetarget peoplepanel/manual_add
Property showtarget editpanel/addfaceselection


peoplepanel/cancel_icon: peoplepanel/manual_cancel
m_offsetRT

peoplepanel/manual_cancel: peoplepanel/manual_frame
m_centerX
YConstraint 0, 0, 285
Property hidetarget peoplepanel/manual_frame
Property showtarget peoplepanel/status_label
Property showtarget peoplepanel/peoplelist
Property showtarget peoplepanel/manual_add
Property hidetarget editpanel/addfaceselection
Property escapekey 1

peoplepanel/manual_instructions: peoplepanel/manual_frame
m_displayfont14
XConstraint 0, 0, 12
XConstraint 1, 1, -12
YConstraint 0, 0, 12

peoplepanel/manual_frame: peoplepanel/base
YConstraint 0, 0, 32
YConstraint 1, 1, -32
XConstraint 0, 0, 16
XConstraint 1, 1, -16
m_hidden

peoplepanel/ignore-label: peoplepanel/ignore
m_buttonfontC
peoplepanel/ignore: peoplepanel/base
m_offsetLT
m_buttontypecolor
m_hidden

peoplepanel/addname: peoplepanel/base
m_buttontypecolor
m_offsetLB
m_hidden

peoplepanel/suggestion_yes: peoplepanel/base
m_offsetLB
m_hidden

peoplepanel/suggestion_no: peoplepanel/base
m_offsetLB
m_hidden

peoplepanel/base: root
m_scaleXY
