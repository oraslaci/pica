XConstraint 1, 1, 0
YConstraint 0, 0, 0
YConstraint 1, 1, 0

uploadmgr/mid_clip: uploadmgr/basepanel
XConstraint 0, 0, 0
XConstraint 1, 1, 0
YConstraint 0, 0, 15
YConstraint 1, 1,-76


