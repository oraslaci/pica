#includeonce macros.tre
#include canoncapturemoviepanelpopup_text.tre

#----------------------------------------
# Filmstrip - Control
#----------------------------------------

canoncapturemoviepanelpopup/face0: canoncapturemoviepanelpopup/filmcontainer
m_scaleY
m_offsetL

canoncapturemoviepanelpopup/face1: canoncapturemoviepanelpopup/filmcontainer
m_scaleY
m_offsetL

canoncapturemoviepanelpopup/face2: canoncapturemoviepanelpopup/filmcontainer
m_scaleY
m_offsetL

canoncapturemoviepanelpopup/face3: canoncapturemoviepanelpopup/filmcontainer
m_scaleY
m_offsetL

canoncapturemoviepanelpopup/filmstrip: canoncapturemoviepanelpopup/filmclip
m_scaleXY

canoncapturemoviepanelpopup/filmcontainer: canoncapturemoviepanelpopup/basepanel
m_hidden
m_offsetB
XConstraint 0, 0, 20
XConstraint 1, 1, -30

#----------------------------------------
# Movie Creator Base Elements
#----------------------------------------

canoncapturemoviepanelpopup/facepreviewbc: canoncapturemoviepanelpopup/moviebk
#m_scaleXY
m_hidden
#m_scaleX
m_centerXY

canoncapturemoviepanelpopup/livepreview: canoncapturemoviepanelpopup/moviebk
#m_scaleXY
m_hidden
#m_scaleX
m_centerXY

canoncapturemoviepanelpopup/moviebk: canoncapturemoviepanelpopup/basepanel
m_offsetLTRB

#Settings ----------------------------------------

canoncapturemoviepanelpopup/video_label: canoncapturemoviepanelpopup/settingspanel
m_offsetLT
m_displayfont14
Property textalign right

canoncapturemoviepanelpopup/videosrc: canoncapturemoviepanelpopup/settingspanel
Property itempadding 2 2 22 2
m_offsetLT

canoncapturemoviepanelpopup/audio_label: canoncapturemoviepanelpopup/settingspanel
m_offsetLT
m_displayfont14
Property textalign right

canoncapturemoviepanelpopup/audiosrc: canoncapturemoviepanelpopup/settingspanel
Property itempadding 2 2 22 2
m_offsetLT

canoncapturemoviepanelpopup/size_label: canoncapturemoviepanelpopup/settingspanel
m_offsetLT
m_displayfont14
Property textalign right

canoncapturemoviepanelpopup/outputsize: canoncapturemoviepanelpopup/settingspanel
