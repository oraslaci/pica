m_buttonfontC
canoncapturemoviepanelpopup/settings_apply: canoncapturemoviepanelpopup/settingspanel
m_buttontypecolor
Property showtarget canoncapturemoviepanelpopup/basepanel
Property hidetarget canoncapturemoviepanelpopup/settingspanel
m_offsetLT

canoncapturemoviepanelpopup/settings_cancel-label: canoncapturemoviepanelpopup/settings_cancel
m_buttonfontC
canoncapturemoviepanelpopup/settings_cancel: canoncapturemoviepanelpopup/settingspanel
m_buttontypecolor
