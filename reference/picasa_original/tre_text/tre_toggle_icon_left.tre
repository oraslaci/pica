#include macros.tre

#------------------------------
Label titledialog/cancel
Cancel

Label titledialog/add
Add

#------------------------------

titledialog/line1: root

titledialog/stylelist: root

#titledialog/font_picker_container: root
#m_scaleX
#m_offsetLT

titledialog/previewtext: titledialog/previewimage
XConstraint 0, 0, 0

titledialog/previewimage: titledialog/previewclip
m_offsetLT

titledialog/previewclip: root
m_offsetLT

titledialog/fontfamily: root

titledialog/fontfamily: root
Property itempadding 2 2 10 2

titledialog/typeface: root
Property itempadding 2 2 10 2

titledialog/sizelist: root
Property itempadding 2 2 5 2

titledialog/captionchk: root
m_offsetLB

titledialog/captiontext: root
m_offsetLB

##colorwheel

titledialog/colorcircle: titledialog/colorwheel_container
XConstraint 0, 0, 0
m_centerY

titledialog/colorwheel: titledialog/colorwheel_container
Property buddy titledialog/colorcircle
XConstraint 1, 1, 0
m_centerY

titledialog/colorwheel_container: root
m_offsetLT

titledialog/add-label: titledialog/add
m_buttonfontLC
titledialog/add: root
m_buttontypecolor
m_offsetRB

titledialog/cancel-label: titledialog/cancel
m_buttonfontLC
titledialog/cancel: root
m_buttontypecolor
m_offsetRB

titledialog/base: root
