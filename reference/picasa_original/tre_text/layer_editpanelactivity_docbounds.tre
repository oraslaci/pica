editpanel/edittextoverlay: editpanel/overlay_group
m_scaleXY
m_hidden
# all these things you can do to change the appearance/utility of the text mode & highlights:
#  editpanel/previewclip : what it clips events to
#  pad 25 : padding around the outside of text which still selects it
#  hcolor and hcolor2 : colors for the highlight nodes
#  hwidth : width (in pixels) of the outline of the highlight node
#  hcorner : an integer defining how curved the corners should be (0 is sharp;  20 is current default)
#  hpad : in pixels, how much white space around text before highlight
Handler multitextnodeselector editpanel/previewclip pad 25 hcolor ff2f2f2f hcolor2 ffffffffff hwidth 15 hpad 25 hopacity 0.7f

editpanel/retouchoverlay: editpanel/overlay_group
m_scaleXY
m_hidden
Handler dragscale thumbui/circlecursor brushslider/scaleslider 100
Handler retoucher thumbui/circlecursor brushslider/scaleslider editpanel/refining_label editpanel/preview

