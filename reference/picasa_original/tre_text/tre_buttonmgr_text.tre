m_centerXY


buttonmgr/rightlist_textclip: buttonmgr/mid_decrect
m_offsetL
YConstraint 0, 0, 6

buttonmgr/leftlist_textclip: buttonmgr/mid_decrect
m_offsetL
YConstraint 0, 0, 6


buttonmgr/mid_decrect: buttonmgr/mid_clip
XConstraint 0,0,10
XConstraint 1,1,-10
YConstraint 0,0,10
YConstraint 1,1,-10

buttonmgr/mid_clip: buttonmgr/basepanel
