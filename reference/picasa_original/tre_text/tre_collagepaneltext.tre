m_offsetLT

collagepanel/rand_placement: collagepanel/rand_group
m_offsetLT

collagepanel/view_and_edit: collagepanel/rand_group
m_offsetLT

collagepanel/rand_group: collagepanel/previewshadow
m_centerX
YConstraint 0, 1, 2

