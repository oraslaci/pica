#-----------------------------------------------------------
# PREVIEW AREA 
#-----------------------------------------------------------
collagepanel/previewshadow: collagepanel/previewinset

collagepanel/previewroot: collagepanel/previewinset

collagepanel/previewinset: collagepanel/previewclip
