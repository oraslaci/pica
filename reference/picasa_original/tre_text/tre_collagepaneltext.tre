#-----------------------------------------------------------
# TAB NAVIGATION
#-----------------------------------------------------------
collagepanel/tab1-label: collagepanel/tab1
m_tabfontC
collagepanel/tab1: collagepanel/tabs
m_buttontypecolor
m_offsetLT
Property showtarget collagepanel/tabpanel1
Property setpressed 1

collagepanel/tab2-label: collagepanel/tab2
m_tabfontC
collagepanel/tab2: collagepanel/tabs
m_buttontypecolor
m_offsetLT
Property showtarget collagepanel/tabpanel2

collagepanel/tabs: collagepanel/tabbase
m_offsetL
YConstraint 0, 0, 5

#-----------------------------------------------------------
# TAB1
#-----------------------------------------------------------
collagepanel/tabpanel1: collagepanel/tabbase
XConstraint 0, 0, 4
XConstraint 1, 1, -4
YConstraint 0, 0, 30
YConstraint 1, 1, -4

#-----------------------------------------------------------
# TAB2
#-----------------------------------------------------------
collagepanel/tabpanel2: collagepanel/tabbase
XConstraint 0, 0, 4
XConstraint 1, 1, -4
YConstraint 0, 0, 30
YConstraint 1, 1, -4
m_hidden

#-----------------------------------------------------------
# GLOBAL BUTTONS 
#-----------------------------------------------------------
collagepanel/cancelbutton: collagepanel/tabbase
m_offsetLB
Property escapekey 1

collagepanel/resetbutton: collagepanel/tabbase
m_offsetLB

collagepanel/makedesktop: collagepanel/tabbase
m_offsetLB

collagepanel/sharebutton: collagepanel/tabbase
m_offsetLB

#-----------------------------------------------------------
# BASE GROUP
#-----------------------------------------------------------
collagepanel/rightcontainer: collagepanel/base
m_offsetLTRB

collagepanel/tabbase: collagepanel/base
m_offsetLT
YConstraint 1, 0, 406
Property enableclip 0

collagepanel/base: root
m_scaleXY