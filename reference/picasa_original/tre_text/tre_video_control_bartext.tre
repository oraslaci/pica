#--------------------------------------------------------------------------
# Time Slider
#--------------------------------------------------------------------------
video_control_bar2/time: video_control_bar2/moviescrubslider_container
m_offsetLTR
m_systemfont11
Property textalign center


video_control_bar2/sliderbaseL: video_control_bar2/sliderbaseC
XConstraint 1, 0, 0
YConstraint 0, 0, 0

video_control_bar2/sliderbaseR: video_control_bar2/sliderbaseC
XConstraint 0, 1, 0
YConstraint 0, 0, 0

video_control_bar2/sliderbaseC: video_control_bar2/moviescrubslider_container
m_offsetT
XConstraint 0, 0, 5
XConstraint 1, 1, -5

video_control_bar2/thumb: video_control_bar2/scaleslider
YConstraint 1, 1, 0

video_control_bar2/limit0: video_control_bar2/scaleslider
m_hidden
m_offsetLT

video_control_bar2/limit1: video_control_bar2/scaleslider
m_hidden
m_offsetLT

video_control_bar2/scaleslider: video_control_bar2/moviescrubslider_container
YConstraint 1, 1, 0
XConstraint 0, 0, 6
XConstraint 1, 1, -5
Property slider 3

#video_control_bar2/moviescrubslider_container: root
#m_offsetT
#XConstraint 0, 0, 60
#XConstraint 1, 1, -112

video_control_bar2/moviescrubslider_container: video_control_bar2/controlbar
m_offsetLTR

#--------------------------------------------------------------------------
# Volume Slider
#--------------------------------------------------------------------------
video_control_bar2/volumeslider_base: video_control_bar2/controlbar
m_offsetRT

video_control_bar2/volumethumb: video_control_bar2/volumeslider
m_offsetLT

video_control_bar2/volumeslider: video_control_bar2/controlbar
m_offsetRT
Property slider 0

#--------------------------------------------------------------------------
# Base Elements
#--------------------------------------------------------------------------
video_control_bar2/moviecontrolsclip: video_control_bar2/controlbar
m_offsetLT

video_control_bar2/fullscreen_icon: video_control_bar2/fullscreen
m_centerXY

video_control_bar2/fullscreen: video_control_bar2/controlbar
m_offsetRT

#video_control_bar2/moviemode2: video_control_bar2/controlbar
#m_offsetRT

video_control_bar2/1to1_icon: video_control_bar2/1to1
m_centerXY

video_control_bar2/1to1: video_control_bar2/controlbar
m_offsetRT

video_control_bar2/controlbar: root
m_scaleX
m_offsetT

Tooltip video_control_bar2/1to1
Show actual movie size (don't stretch)

Tooltip video_control_bar2/fullscreen
Play full screen