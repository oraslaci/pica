#includeonce macros.tre
#include compose_mail_text.tre

#----------------------------------------
# COMPOSE
#----------------------------------------

compose_mail/googlemail: root
m_offsetLT
m_hidden

compose_mail/gmail: root
m_offsetLT

compose_mail/to_text: compose_mail/composeclip
m_offsetLT
m_displayfont14
Property textalign right

compose_mail/subject_text: compose_mail/composeclip
m_offsetLT
m_displayfont14
Property textalign right

#----------------------------------------
# Send Buttons
#---------------------------------------->
compose_mail/focdiscardb: compose_mail/discardb
Property alias compose_mail/discard
m_hidden
compose_mail/discardb: compose_mail/bottomstrip
m_cmbuttonL
m_offsetLB
Property alias compose_mail/discard
Property focustarget compose_mail/focdiscardb

compose_mail/focsendb: compose_mail/sendb
m_hidden

compose_mail/sendb: compose_mail/bottomstrip
m_cmbuttonL
m_offsetLB
Property alias compose_mail/send
Property focustarget compose_mail/focsendb

compose_mail/bottomstrip: compose_mail/composeclip
m_offsetLB
m_scaleX

compose_mail/focdiscard: compose_mail/discard
Property alias compose_mail/discard
m_hidden

compose_mail/discard: compose_mail/topstrip
Property focustarget compose_mail/focdiscard
m_cmbuttonL
m_offsetLT

compose_mail/focsend: compose_mail/send
Property alias compose_mail/send
m_hidden

compose_mail/send: compose_mail/topstrip
Property focustarget compose_mail/focsend
m_cmbuttonL
m_offsetLT

compose_mail/topstrip: compose_mail/composeclip
m_offsetRT
m_scaleX

#---------------------------------------->

compose_mail/curuser: compose_mail/logininfo
m_displayfont14
Property textalign right
m_offsetRT

compose_mail/changeuser-label: compose_mail/changeuser
m_displayfont14
XConstraint 0, 0, 0
YConstraint .5, .5, 0
compose_mail/changeuser: compose_mail/logininfo
m_offsetRT

compose_mail/divider: compose_mail/logininfo
m_offsetRB

compose_mail/logininfo: compose_mail/compose
XConstraint 1, 1, 45
YConstraint 0, 0, 55

compose_mail/clipicon: compose_mail/composeclip
m_offsetLT

compose_mail/to: compose_mail/topentry
m_offsetLTR

compose_mail/subject: compose_mail/topentry
m_offsetLTR

compose_mail/topentry: compose_mail/composeclip
m_offsetT
XConstraint 0, 0, 94
XConstraint 1, 1, -10

compose_mail/infotext: compose_mail/composeclip
m_hidden
m_offsetLT

compose_mail/preview: compose_mail/piccontainer
m_centerXY
Property croptofit

compose_mail/piccontainer: compose_mail/composeclip
m_offsetLT

compose_mail/picstroke: compose_mail/composeclip
m_offsetLT

compose_mail/navleft_icon: compose_mail/navleft
m_centerXY
compose_mail/navleft: compose_mail/composeclip
m_offsetLT

compose_mail/discardimage_icon: compose_mail/discardimage
m_centerXY
compose_mail/discardimage: compose_mail/composeclip
m_offsetLT

compose_mail/navright_icon: compose_mail/navright
m_centerXY
compose_mail/navright: compose_mail/composeclip
m_offsetLT

compose_mail/ltr_icon: compose_mail/ltr
m_centerXY

compose_mail/ltr: compose_mail/bidi_container
m_offsetLT
Property mousedown 1

compose_mail/rtl_icon: compose_mail/rtl
m_centerXY

compose_mail/rtl: compose_mail/bidi_container
m_offsetLT
Property mousedown 1
Property setpressed 1

compose_mail/bidi_container: compose_mail/composeclip
m_offsetLT
m_hidden

compose_mail/content: compose_mail/composeclip
m_offsetT
XConstraint 0, 0, 10
XConstraint 1, 1, -10
YConstraint 1, 1, -45

#compose_mail/bottomentry: compose_mail/composeclip
#m_offsetT
#XConstraint 0, 0, 10
#XConstraint 1, 1, -10
#YConstraint 1, 1, -45

compose_mail/composeclip: compose_mail/compose
XConstraint 0, 0, 10
XConstraint 1, 1, -10
YConstraint 0, 0, 80
YConstraint 1, 1, -10

compose_mail/compose: root