#-----------------------------------------------------------
# Preview
#-----------------------------------------------------------

makemoviepanel/movieparent: makemoviepanel/moviebk
m_hidden

makemoviepanel/previewimage: makemoviepanel/moviebk
m_hidden

makemoviepanel/video_control_container: makemoviepanel/movieparent_tracker
XConstraint 0, 0, 0
XConstraint 1, 1, 0
YConstraint 1, 1, 32

makemoviepanel/movieparent_tracker: makemoviepanel/moviebk
m_scaleX
YConstraint 0, 0, 0
YConstraint 1, 1, 0

makemoviepanel/moviebk: makemoviepanel/previewpanel
#m_offsetLTRB
m_offsetTB
XConstraint 0, 0, 4
XConstraint 1, 1, -4

makemoviepanel/filmbase: makemoviepanel/insetleft
YConstraint 1, 1, 0
m_scaleX

makemoviepanel/inserticon: makemoviepanel/insert_slide
YConstraint 0.5, 0.5, -1
XConstraint 0.5, 0.5, -1

makemoviepanel/insert_slide: makemoviepanel/insetleft
m_offsetLB

makemoviepanel/removeicon: makemoviepanel/remove_slide
m_centerXY

makemoviepanel/remove_slide: makemoviepanel/insetleft
m_offsetLB

#-----------------------------------------------------------
# Basecontrol/filmstrip
#-----------------------------------------------------------

makemoviepanel/indicator: makemoviepanel/filmstrip
