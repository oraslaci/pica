m_offsetT
m_scaleX
m_displayfont12
Property textalign center

makemoviepanel/infotext_clip: makemoviepanel/insetleft
m_offsetB
XConstraint 0, 0, 10
XConstraint 1, 1, 0

makemoviepanel/filmoverlaycontainer: makemoviepanel/insetleft
m_offsetB
XConstraint 0, 0, 8
XConstraint 1, 1, 0
Property round 5

