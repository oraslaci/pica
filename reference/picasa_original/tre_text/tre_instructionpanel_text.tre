#includeonce macros.tre
#include instructionpanel_text.tre

instructionpanel/title: instructionpanel/base
XConstraint 0, 0, 40
XConstraint 1, 1, -40
YConstraint 0, 0, 16
m_displayfont16
Property textalign center

instructionpanel/body: instructionpanel/base
XConstraint 0, 0, 16
XConstraint 1, 1, -16
YConstraint 0, 0, 45
m_displayfont14

#instructionpanel/x_close: instructionpanel/base
#YConstraint 0, 0, 16
#XConstraint 1, 1, -16

instructionpanel/close-label: instructionpanel/close
m_buttonfontC
instructionpanel/close: instructionpanel/base
m_buttontypecolor3
m_offsetRB

instructionpanel/learn_more-label: instructionpanel/learn_more
m_buttonfontC
instructionpanel/learn_more: instructionpanel/base
m_buttontypecolor3
m_offsetLB

instructionpanel/base: root
