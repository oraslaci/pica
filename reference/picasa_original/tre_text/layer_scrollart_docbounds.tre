
scratch/oemlogo: scratch/oemlogo_clip
m_centerXY
Property usealpha 1
m_hidden

scratch/oemlogo_clip: root
m_centerXY

scratch/albumcover: scratch/albumsize
m_centerXY
Property usealpha 1

scratch/albumsize: scratch/album
XConstraint 0, 0, 8
XConstraint 1, 1, -8
YConstraint 0, 0, 8
YConstraint 1, 1, -8

scratch/highlight: scratch/albumlabel
XConstraint 0, 0, -4
XConstraint 1, 1, 4
#YConstraint .5, .5, 1
YConstraint 0, 0, 0
YConstraint 1, 1, 1
Property round 2
#Property useshadow 1

Property predraw 1
# I chose this dumb constraint because the tray can get so small that there's no room for text
scratch/albumlabel: scratch/album
m_centerXY
#m_displayfont14
m_displayfont12

scratch/album: root
m_scaleXY
m_hidden

